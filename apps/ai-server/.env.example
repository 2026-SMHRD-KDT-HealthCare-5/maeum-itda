# === OpenAI STT (/v1/audio/transcriptions) ===
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_STT_LANGUAGE=ko
OPENAI_STT_PROMPT=
OPENAI_TIMEOUT_SEC=60

# === OpenAI LLM (Chat Completions, 꼬리질문 생성) ===
OPENAI_LLM_MODEL=gpt-4o
OPENAI_LLM_TIMEOUT_SEC=15

# === STT 로컬 폴백 (faster-whisper) ===
LOCAL_WHISPER_MODEL_SIZE=small
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_COMPUTE_TYPE=
LOCAL_WHISPER_LANGUAGE=ko
LOCAL_WHISPER_BEAM_SIZE=5
LOCAL_WHISPER_VAD_FILTER=true

# === Typecast TTS (/v1/text-to-speech) ===
# API 키 발급: https://typecast.ai  (Typecast API Console)
# voice_id 확인: list_voices() 헬퍼 호출 또는 https://api.typecast.ai/v2/voices
TYPECAST_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TYPECAST_VOICE_ID=tc_xxxxxxxxxxxxxxxxxxxxxxxx
TYPECAST_MODEL=ssfm-v30
TYPECAST_LANG=kor
TYPECAST_EMOTION_PRESET=normal
TYPECAST_EMOTION_INTENSITY=1.0
TYPECAST_AUDIO_FORMAT=mp3
TYPECAST_AUDIO_TEMPO=1.0
TYPECAST_AUDIO_PITCH=0
TYPECAST_TARGET_LUFS=-14.0

# === 감정 분류 모델 체크포인트 경로 ===
# test: 실제 모델을 호출하지 않고 sad=1.0 고정값 사용 / model: 실제 모델 추론
EMOTION_MODE=model
TEXT_EMOTION_MODEL_PATH=C:/absolute/path/to/models/text_emotion
VOICE_EMOTION_MODEL_PATH=C:/absolute/path/to/models/voice_emotion/kresnik_baseline_best.pt
EMOTION_DEVICE=auto

# === 감정 융합 ===
# 온도 보정값과 클래스별 가중치는 app/services/emotion.py의 현재 후보값을 사용한다.

# === 척도 채점 ===
# test: 답변마다 고정 목업 채점(GAD_7 4번, 1점) 반환 / empty: 항상 빈 배열 반환
# model: SYSTEM_PROMPT(llm_prompts.py) 채점 규칙으로 실제 LLM 채점 사용
SCALE_ANALYSIS_MODE=test

# === STT 교정 (SCALE_ANALYSIS_MODE와 독립적으로 토글) ===
# test: STT 원문 그대로 사용 / model: SYSTEM_PROMPT의 corrected_transcript 신뢰
STT_CORRECTION_MODE=test

# === UC-06-4 일간 요약·추천 행동 생성 ===
# test: 고정 목업 문구 반환 / model: DAILY_SUMMARY_SYSTEM_PROMPT로 실제 생성
DAILY_SUMMARY_MODE=test

# === 서버 ===
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
