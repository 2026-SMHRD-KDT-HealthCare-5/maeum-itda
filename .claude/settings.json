{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list*)",
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm dev*)",
      "Bash(pnpm build*)",
      "Bash(pnpm lint*)",
      "Bash(npx lint-staged*)",
      "Bash(pnpm --filter *)",
      "Bash(turbo run *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/warn-large-read.js\"",
            "statusMessage": "Checking file size before full read..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "if": "Bash(git commit *)",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/lint-before-commit.sh\"",
            "statusMessage": "Checking formatting and lint before commit...",
            "timeout": 120
          },
          {
            "type": "command",
            "shell": "bash",
            "if": "Bash(npm *)",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/warn-non-pnpm.sh\""
          },
          {
            "type": "command",
            "shell": "bash",
            "if": "Bash(yarn *)",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/warn-non-pnpm.sh\""
          }
        ]
      }
    ]
  }
}
